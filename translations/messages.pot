msgid "Rotation (degrees)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:219
msgid "1-359 degrees, -1 disables rotation."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:231
msgid "Capture pause (seconds)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:231
msgid "Pause between captured frames (--encodewait). Default 0.5."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:246
msgid "Show activity dot (red dot every other frame)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:246
msgid ""
"Draws a small red dot on every other frame so you can tell at a glance "
"that the stream is live and not a frozen image."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:251
msgid "Show FPS watermark (costs CPU)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:251
msgid ""
"Overlays the current frame rate on the video. The text is redrawn on "
"every frame, which costs extra CPU on small boards like a Pi."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:258
msgid "Timelapse downloads"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:264
msgid "Prefix filenames with the print job name"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:264
msgid ""
"Prepends the print job's file name to each downloaded timelapse, so "
"videos are easy to match to their print. Only for videos whose print end "
"this plugin recorded."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:270
msgid "Filename suffix"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:270
msgid ""
"Optional. Appended before the extension (e.g. _bambu) so downloads are "
"easy to tell apart from OctoPrint's own renders."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:283
msgid "Convert downloaded .avi to .mp4"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:283
msgid ""
"Re-encodes each copied .avi to .mp4 (removing the .avi) using OctoPrint's"
" ffmpeg. Skipped while printing."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:288
msgid "ffmpeg found"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:293
msgid ""
"ffmpeg not found — set it under Settings → Webcam &amp; Timelapse. "
"Conversion will be skipped until then."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:296
msgid "Checking ffmpeg…"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:302
#: octoprint_bambucam/templates/bambucam_settings.jinja2:378
msgid "Use the print job's gcode preview as the thumbnail"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:302
msgid ""
"Off by default. Uses the print job's slicer plate preview (from Bambu "
"Connector) as the video's thumbnail instead of a frame from the "
"timelapse. Falls back to a video frame when no preview is found."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:311
msgid "Automatically pull new timelapses after a print"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:311
msgid ""
"After a print finishes, copy/move the printer's new timelapse "
"automatically — only once the printer is idle and OctoPrint finished its "
"own render."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:314
msgid ""
"Copying from the printer's SD card is slow and shares the processor that "
"drives the touchscreen, so the display can feel sluggish while a copy "
"runs — it waits for the printer to be idle first, but a copy right after "
"a print can still make the touchscreen lag until it finishes."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:321
msgid "Auto-pull action"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:321
msgid ""
"Copy leaves the video on the printer's SD card; Move deletes it there "
"after a successful download so the card doesn't fill up."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:325
msgid "Copy (keep on SD card)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:326
msgid "Move (delete from SD card)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:333
msgid "Delay after print"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:333
msgid ""
"How long to wait after a print before checking the SD card (the printer "
"writes its timelapse with a delay)."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:342
msgid "seconds"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:349
msgid "General"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:355
msgid "Enable the raw-footage render pipeline"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:355
msgid ""
"Master switch for turning raw /ipcam footage into videos: harvesting, the"
" render queue, startup recovery and retention cleanup. Already downloaded"
" chunks are kept when off."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:360
msgid "Show the \"Raw Files\" subtab"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:360
msgid ""
"Cosmetic only: hides the Raw Files subtab from the BambuCam tab. The "
"render pipeline keeps working in the background."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:365
msgid "Auto-download /ipcam chunks when a print finishes"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:365
msgid ""
"Harvests this print's raw /ipcam footage into the Raw Files tab when the "
"print ends, ready to concat and render. Live webcam stream is paused "
"during the harvest."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:368
msgid ""
"Harvesting raw /ipcam footage is slow, touchscreen display can feel "
"sluggish while a harvest runs."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:373
msgid "Auto-render freshly downloaded groups (default preset, idle only)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:373
msgid ""
"When a harvest downloads a group completely, queue a render with the "
"default preset — same job as the Concat + Render button. Queue's idle "
"gate still applies."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:378
msgid ""
"Off by default. Uses the print job's slicer plate preview (from Bambu "
"Connector) as the rendered clip's thumbnail instead of a frame from the "
"video. Falls back to a video frame when no preview is found."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:384
msgid "Default preset"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:384
msgid ""
"Encode profile preselected for a render. Fast 720p: 1280 px, 5×, "
"smallest/quickest (Pi default). Medium 1080p: 1920 px, 2×, balanced. "
"Quality 1080p: 1920 px, real-time, best but slow. Original: full res, "
"archival, slowest."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:388
msgid "Fast 720p"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:389
msgid "Medium 1080p"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:390
msgid "Quality 1080p"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:391
msgid "Original (archive, slow)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:395
msgid "Performance"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:401
msgid "Render only when the printer is idle"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:401
msgid ""
"Queued renders wait until no print is running, so ffmpeg never competes "
"with an active print for CPU. Turn off to render immediately."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:407
msgid "Max queue size"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:407
msgid ""
"Maximum number of renders waiting in the queue; further requests are "
"rejected until one finishes. Default 10."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:418
msgid "Render timeout (s)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:418
msgid ""
"A render that runs longer than this is aborted and marked failed. 0 = "
"default (1800 s / 30 min). Raise for the Original preset on slow "
"hardware."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:427
msgid "Cleanup &amp; Safety"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:433
msgid "Move deleted files to trash first (soft-delete)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:433
msgid ""
"Deleting a raw-footage group moves it to a trash folder instead of "
"removing it right away; trash is purged by the retention sweep. Off = "
"delete immediately."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:439
msgid "Chunk retention (days)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:439
msgid ""
"Rendered groups are cleaned this many days after their render (0 = keep "
"forever); trash entries older than this are purged. Groups that were "
"never rendered are exempt."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:450
msgid "Stale lock timeout (s)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:450
msgid ""
"If a render crashes it leaves a lockfile behind; locks older than this "
"are reclaimed at startup and the job is marked failed. Default 86400 (1 "
"day)."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:462
msgid "Daemon"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:468
msgid "Automatically restart the stream server after crashes"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:468
msgid ""
"Restarts the stream server when it exits unexpectedly, up to 'Max "
"restarts' within the restart window below."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:473
msgid "Log HTTP requests of the stream server (debug)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:473
msgid ""
"Writes every HTTP request to the stream server into its own rotating log "
"file (plugin_bambucam_http.log). Only needed for debugging."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:479
msgid "Max restarts"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:479
msgid ""
"Give up auto-restarting after this many crashes within the restart "
"window. Only used when auto-restart is enabled."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:490
msgid "Restart window (seconds)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:490
msgid ""
"Time window over which the crash count is measured. Only used when auto-"
"restart is enabled."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:499
msgid "FFmpeg / FFprobe"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:501
msgid ""
"Leave empty to use OctoPrint's webcam ffmpeg and the ffprobe next to it. "
"Used for the Raw Files render pipeline."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:505
msgid "ffmpeg path"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:505
msgid ""
"Full path to the ffmpeg binary used by the Raw Files render pipeline. "
"Empty = OctoPrint's webcam ffmpeg. 'Test' runs it with -version."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:513
msgid "Test FFmpeg"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:520
msgid "ffprobe path"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:520
msgid ""
"Full path to ffprobe, used to read chunk durations and resolutions. Empty"
" = the ffprobe next to the ffmpeg above. 'Test' runs it with -version."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:528
msgid "Test FFprobe"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:535
msgid "ffmpeg threads"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:535
msgid ""
"CPU threads ffmpeg uses to encode. 1 (default) keeps a Pi responsive; "
"raise for faster renders; 0 = all cores. Applies to both the Raw Files "
"render and the printer-timelapse .avi→.mp4 conversion."
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:544
msgid "Diagnostics"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:550
msgid "Query stream server (/?info)"
msgstr ""

#: octoprint_bambucam/templates/bambucam_settings.jinja2:552
msgid ""
"Fetches live stats from the local stream server (the access code is never"
" returned). The server must be running."
msgstr ""

